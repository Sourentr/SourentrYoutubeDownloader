<Window x:Class="YoutubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Youtube Downloader"
        Height="800"
        Width="1250"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0E1118"
        Foreground="#F1F3F9"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#171C27"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#293142"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#919BB0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8175F5"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#8175F5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#222938"/>
            <Setter Property="Foreground" Value="#F1F3F9"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101520"/>
            <Setter Property="Foreground" Value="#F1F3F9"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#343D50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#222938"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#343D50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton
                        Focusable="False"
                        ClickMode="Press"
                        IsChecked="{Binding IsDropDownOpen,
                            RelativeSource={RelativeSource TemplatedParent},
                            Mode=TwoWay}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="#F3F4F6"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="{Binding SelectionBoxItem,
                            RelativeSource={RelativeSource TemplatedParent}}"
                        TextElement.Foreground="#F3F4F6"
                        IsHitTestVisible="False"/>

                            <Popup Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                                <Border Background="#252936"
                                BorderBrush="#343D50"
                                BorderThickness="1"
                                MinWidth="{Binding ActualWidth,
                                    RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="250">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="Background" Value="#252936"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#3B4255"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#3B4255"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAB3C5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0"
                Background="#121722"
                BorderBrush="#252D3B"
                BorderThickness="0,0,1,0">

            <DockPanel Margin="20">

                <StackPanel DockPanel.Dock="Top">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,34">
                        <Border Width="38"
                                Height="38"
                                CornerRadius="10"
                                Background="#8175F5"
                                Margin="0,0,11,0">
                            <TextBlock Text="M"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Youtube Loader"
                                       FontWeight="Bold"
                                       FontSize="16"/>
                            <TextBlock Text="MEDIA TOOLKIT"
                                       Foreground="#919BB0"
                                       FontSize="9"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="WORKSPACE"
                               Foreground="#737F95"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="12,0,0,10"/>

                    <Button Style="{StaticResource NavigationButton}"
                            Background="#292644"
                            Foreground="#BDB5FF"
                            Content="⌂    Downloader"/>

                    <Button Style="{StaticResource NavigationButton}"
                            Content="▤    My Downloads"/>

                    <Button Style="{StaticResource NavigationButton}"
                            Content="◷    History"/>

                    <TextBlock Text="PREFERENCES"
                               Foreground="#737F95"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="12,28,0,10"/>

                    <Button Style="{StaticResource NavigationButton}"
                            Content="⚙    Settings"/>

                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="#1B2230"
                        BorderBrush="#30394B"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Your media workspace"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                        <TextBlock Text="Organize your authorized media downloads in one place."
                                   Foreground="#919BB0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

            </DockPanel>
        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="34,28,34,35">

                <!-- Header -->
                <Grid Margin="0,0,0,28">
                    <StackPanel>
                        <TextBlock Text="Downloader"
                                   FontSize="28"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Import a link, choose a format, and manage your media."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   Margin="0,7,0,0"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#1D2930"
                            CornerRadius="15"
                            Padding="11,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="#54D6A0"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="READY"
                                       Foreground="#8BE4BB"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Link input card -->
                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="22"
                        Margin="0,0,0,22">

                    <StackPanel>
                        <TextBlock Text="Import media"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Paste a YouTube URL to get started."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,6,0,17"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="UrlTextBox"
                                     Grid.Column="0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Paste a YouTube URL here"
                                     Margin="0,0,10,0"/>

                            <Button Grid.Column="1"
                                    Content="Paste link"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="PasteButton_Click"/>
                        </Grid>

                        <Button Content="Analyze link"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,15,0,0"
                                Click="AnalyzeButton_Click"/>

                        <TextBlock x:Name="StatusText"
                                   Text="Ready for a link."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Video information -->
                <TextBlock Text="Media details"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,22">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="100"
                                CornerRadius="9"
                                Background="#242B3A">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="▶"
                                           FontSize="28"
                                           Foreground="#A99FFF"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="PREVIEW"
                                           FontSize="9"
                                           Foreground="#AAB3C5"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">
                            <TextBlock x:Name="VideoTitleText"
                                       Text="No media selected"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>

                            <TextBlock x:Name="ChannelText"
                                       Text="Video title and channel information will appear here."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>

                            <TextBlock x:Name="DurationText"
                                       Text="Duration: —"
                                       Foreground="#AAB3C5"
                                       FontSize="12"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Output settings -->
                <TextBlock Text="Output settings"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,22">

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,10,0">
                                <TextBlock Text="Format"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="FormatComboBox"
                                          SelectedIndex="0"
                                          SelectionChanged="FormatComboBox_SelectionChanged"
                                          Foreground="#F3F4F6"
                                          Background="#252936">
                                          
                                    <ComboBoxItem Content="MP4 — Video"/>
                                    <ComboBoxItem Content="MP3 — Audio"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0">
                                <TextBlock Text="Quality"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="QualityComboBox"
                                          Foreground="#F3F4F6"
                                          Background="#252936"
                                          SelectedIndex="2">
                                    <ComboBoxItem Content="360p"/>
                                    <ComboBoxItem Content="480p"/>
                                    <ComboBoxItem Content="720p"/>
                                    <ComboBoxItem Content="1080p"/>
                                    <ComboBoxItem Content="1440p"/>
                                    <ComboBoxItem Content="2160p (4K)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Save location"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,18,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="OutputPathTextBox"
                                     Grid.Column="0"
                                     Text="Downloads"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,10,0"/>

                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BrowseFolderButton_Click"/>
                        </Grid>

                        <TextBlock Text="The actual available quality options will depend on the source and supported download method."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Download progress -->
                <TextBlock Text="Download progress"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20">

                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="ProgressStatusText"
                                       Text="Waiting to start"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="ProgressPercentText"
                                       Text="0%"
                                       Foreground="#BDB5FF"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <ProgressBar x:Name="DownloadProgressBar"
                                     Height="7"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Background="#293142"
                                     Foreground="#8175F5"
                                     BorderThickness="0"/>

                        <Grid Margin="0,12,0,0">
                            <TextBlock x:Name="SpeedText"
                                       Text="Speed: —"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"/>

                            <TextBlock x:Name="RemainingText"
                                       Text="Time remaining: —"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Button x:Name="DownloadButton"
                                Content="Download"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0"
                                Click="DownloadButton_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="MediaDownloader • Built with C# and WPF"
                           Foreground="#667188"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,25,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

<Window x:Class="YoutubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Youtube Downloader"
        Height="800"
        Width="1250"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource C_0E1118}"
        Foreground="{DynamicResource C_F1F3F9}"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Dynamic colour resources make the selected theme apply throughout the UI. -->
        <SolidColorBrush x:Key="C_0E1118" Color="#0E1118"/>
        <SolidColorBrush x:Key="C_101520" Color="#101520"/>
        <SolidColorBrush x:Key="C_121722" Color="#121722"/>
        <SolidColorBrush x:Key="C_171C27" Color="#171C27"/>
        <SolidColorBrush x:Key="C_1B2230" Color="#1B2230"/>
        <SolidColorBrush x:Key="C_1D2930" Color="#1D2930"/>
        <SolidColorBrush x:Key="C_222938" Color="#222938"/>
        <SolidColorBrush x:Key="C_242B3A" Color="#242B3A"/>
        <SolidColorBrush x:Key="C_252936" Color="#252936"/>
        <SolidColorBrush x:Key="C_252D3B" Color="#252D3B"/>
        <SolidColorBrush x:Key="C_292644" Color="#292644"/>
        <SolidColorBrush x:Key="C_293142" Color="#293142"/>
        <SolidColorBrush x:Key="C_30394B" Color="#30394B"/>
        <SolidColorBrush x:Key="C_343D50" Color="#343D50"/>
        <SolidColorBrush x:Key="C_3B4255" Color="#3B4255"/>
        <SolidColorBrush x:Key="C_54D6A0" Color="#54D6A0"/>
        <SolidColorBrush x:Key="C_667188" Color="#667188"/>
        <SolidColorBrush x:Key="C_737F95" Color="#737F95"/>
        <SolidColorBrush x:Key="C_8175F5" Color="#8175F5"/>
        <SolidColorBrush x:Key="C_8BE4BB" Color="#8BE4BB"/>
        <SolidColorBrush x:Key="C_919BB0" Color="#919BB0"/>
        <SolidColorBrush x:Key="C_A99FFF" Color="#A99FFF"/>
        <SolidColorBrush x:Key="C_AAB3C5" Color="#AAB3C5"/>
        <SolidColorBrush x:Key="C_BDB5FF" Color="#BDB5FF"/>
        <SolidColorBrush x:Key="C_F1F3F9" Color="#F1F3F9"/>
        <SolidColorBrush x:Key="C_F3F4F6" Color="#F3F4F6"/>

        <SolidColorBrush x:Key="PanelBrush" Color="#171C27"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#293142"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#919BB0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8175F5"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource C_8175F5}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource C_222938}"/>
            <Setter Property="Foreground" Value="{DynamicResource C_F1F3F9}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource C_101520}"/>
            <Setter Property="Foreground" Value="{DynamicResource C_F1F3F9}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource C_343D50}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{DynamicResource C_222938}"/>
            <Setter Property="Foreground" Value="{DynamicResource C_F3F4F6}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource C_343D50}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton
                        Focusable="False"
                        ClickMode="Press"
                        IsChecked="{Binding IsDropDownOpen,
                            RelativeSource={RelativeSource TemplatedParent},
                            Mode=TwoWay}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{DynamicResource C_F3F4F6}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="{Binding SelectionBoxItem,
                            RelativeSource={RelativeSource TemplatedParent}}"
                        TextElement.Foreground="{DynamicResource C_F3F4F6}"
                        IsHitTestVisible="False"/>

                            <Popup Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                                <Border Background="{DynamicResource C_252936}"
                                BorderBrush="{DynamicResource C_343D50}"
                                BorderThickness="1"
                                MinWidth="{Binding ActualWidth,
                                    RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="250">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource C_F3F4F6}"/>
            <Setter Property="Background" Value="{DynamicResource C_252936}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{DynamicResource C_3B4255}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{DynamicResource C_3B4255}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource C_AAB3C5}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0"
                Background="{DynamicResource C_121722}"
                BorderBrush="{DynamicResource C_252D3B}"
                BorderThickness="0,0,1,0">

            <DockPanel Margin="20">

                <StackPanel DockPanel.Dock="Top">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,34">
                        <Border Width="38"
                                Height="38"
                                CornerRadius="10"
                                Background="{DynamicResource C_8175F5}"
                                Margin="0,0,11,0">
                            <TextBlock Text="M"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Youtube Loader"
                                       FontWeight="Bold"
                                       FontSize="16"/>
                            <TextBlock Text="MEDIA TOOLKIT"
                                       Foreground="{DynamicResource C_919BB0}"
                                       FontSize="9"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="WORKSPACE"
                               Foreground="{DynamicResource C_737F95}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="12,0,0,10"/>

                    <Button x:Name="DownloaderNavButton"
                            Style="{StaticResource NavigationButton}"
                            Content="⌂    Downloader"
                            Click="DownloaderNavigation_Click"/>

                    <Button x:Name="HistoryNavButton"
                            Style="{StaticResource NavigationButton}"
                            Content="◷    History"
                            Click="HistoryNavigation_Click"/>

                    <TextBlock Text="PREFERENCES"
                               Foreground="{DynamicResource C_737F95}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="12,28,0,10"/>

                    <Button x:Name="SettingsNavButton"
                            Style="{StaticResource NavigationButton}"
                            Content="⚙    Settings"
                            Click="SettingsNavigation_Click"/>

                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource C_1B2230}"
                        BorderBrush="{DynamicResource C_30394B}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Your media workspace"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                        <TextBlock Text="Organize your authorized media downloads in one place."
                                   Foreground="{DynamicResource C_919BB0}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

            </DockPanel>
        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <!-- ScrollViewer must contain exactly one child; this wrapper hosts both pages. -->
            <StackPanel>
            <StackPanel x:Name="DownloaderPage" Margin="34,28,34,35">

                <!-- Header -->
                <Grid Margin="0,0,0,28">
                    <StackPanel>
                        <TextBlock Text="Downloader"
                                   FontSize="28"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Import a link, choose a format, and manage your media."
                                   Foreground="{DynamicResource C_919BB0}"
                                   FontSize="13"
                                   Margin="0,7,0,0"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource C_1D2930}"
                            CornerRadius="15"
                            Padding="11,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{DynamicResource C_54D6A0}"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="READY"
                                       Foreground="{DynamicResource C_8BE4BB}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Link input card -->
                <Border Background="{DynamicResource C_171C27}"
                        BorderBrush="{DynamicResource C_293142}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="22"
                        Margin="0,0,0,22">

                    <StackPanel>
                        <TextBlock Text="Import media"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Paste a YouTube URL to get started."
                                   Foreground="{DynamicResource C_919BB0}"
                                   FontSize="12"
                                   Margin="0,6,0,17"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="UrlTextBox"
                                     Grid.Column="0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Paste a YouTube URL here"
                                     Margin="0,0,10,0"/>

                            <Button Grid.Column="1"
                                    Content="Paste link"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="PasteButton_Click"/>
                        </Grid>

                        <Button Content="Analyze link"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,15,0,0"
                                Click="AnalyzeButton_Click"/>

                        <TextBlock x:Name="StatusText"
                                   Text="Ready for a link."
                                   Foreground="{DynamicResource C_919BB0}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Video information -->
                <TextBlock Text="Media details"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <Border Background="{DynamicResource C_171C27}"
                        BorderBrush="{DynamicResource C_293142}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,22">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="100"
                                CornerRadius="9"
                                Background="{DynamicResource C_242B3A}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="▶"
                                           FontSize="28"
                                           Foreground="{DynamicResource C_A99FFF}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="PREVIEW"
                                           FontSize="9"
                                           Foreground="{DynamicResource C_AAB3C5}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">
                            <TextBlock x:Name="VideoTitleText"
                                       Text="No media selected"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>

                            <TextBlock x:Name="ChannelText"
                                       Text="Video title and channel information will appear here."
                                       Foreground="{DynamicResource C_919BB0}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>

                            <TextBlock x:Name="DurationText"
                                       Text="Duration: —"
                                       Foreground="{DynamicResource C_AAB3C5}"
                                       FontSize="12"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Output settings -->
                <TextBlock Text="Output settings"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <Border Background="{DynamicResource C_171C27}"
                        BorderBrush="{DynamicResource C_293142}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,22">

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,10,0">
                                <TextBlock Text="Format"
                                           FontSize="12"
                                           Foreground="{DynamicResource C_919BB0}"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="FormatComboBox"
                                          SelectedIndex="0"
                                          SelectionChanged="FormatComboBox_SelectionChanged"
                                          Foreground="{DynamicResource C_F3F4F6}"
                                          Background="{DynamicResource C_252936}">
                                          
                                    <ComboBoxItem Content="MP4 — Video"/>
                                    <ComboBoxItem Content="MP3 — Audio"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0">
                                <TextBlock Text="Quality"
                                           FontSize="12"
                                           Foreground="{DynamicResource C_919BB0}"
                                           Margin="0,0,0,8"/>

                                <ComboBox x:Name="QualityComboBox"
                                          Foreground="{DynamicResource C_F3F4F6}"
                                          Background="{DynamicResource C_252936}"
                                          SelectedIndex="2">
                                    <ComboBoxItem Content="360p"/>
                                    <ComboBoxItem Content="480p"/>
                                    <ComboBoxItem Content="720p"/>
                                    <ComboBoxItem Content="1080p"/>
                                    <ComboBoxItem Content="1440p"/>
                                    <ComboBoxItem Content="2160p (4K)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Save location"
                                   FontSize="12"
                                   Foreground="{DynamicResource C_919BB0}"
                                   Margin="0,18,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="OutputPathTextBox"
                                     Grid.Column="0"
                                     Text="Downloads"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,10,0"/>

                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BrowseFolderButton_Click"/>
                        </Grid>

                        <TextBlock Text="The actual available quality options will depend on the source and supported download method."
                                   Foreground="{DynamicResource C_919BB0}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Download progress -->
                <TextBlock Text="Download progress"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <Border Background="{DynamicResource C_171C27}"
                        BorderBrush="{DynamicResource C_293142}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20">

                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="ProgressStatusText"
                                       Text="Waiting to start"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="ProgressPercentText"
                                       Text="0%"
                                       Foreground="{DynamicResource C_BDB5FF}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <ProgressBar x:Name="DownloadProgressBar"
                                     Height="7"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Background="{DynamicResource C_293142}"
                                     Foreground="{DynamicResource C_8175F5}"
                                     BorderThickness="0"/>

                        <Grid Margin="0,12,0,0">
                            <TextBlock x:Name="SpeedText"
                                       Text="Speed: —"
                                       Foreground="{DynamicResource C_919BB0}"
                                       FontSize="11"/>

                            <TextBlock x:Name="RemainingText"
                                       Text="Time remaining: —"
                                       Foreground="{DynamicResource C_919BB0}"
                                       FontSize="11"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Button x:Name="DownloadButton"
                                Content="Download"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0"
                                Click="DownloadButton_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="MediaDownloader • Built with C# and WPF"
                           Foreground="{DynamicResource C_667188}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,25,0,0"/>

            </StackPanel>

            <StackPanel x:Name="HistoryPage" Margin="34,28,34,35" Visibility="Collapsed">
                <Grid Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="History" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Review recent successful and failed download attempts."
                                   Foreground="{DynamicResource C_919BB0}" FontSize="13" Margin="0,7,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Click="RefreshHistoryButton_Click"/>
                        <Button Content="Clear history" Style="{StaticResource SecondaryButton}"
                                Click="ClearHistoryButton_Click"/>
                    </StackPanel>
                </Grid>
                <Border Background="{DynamicResource C_171C27}" BorderBrush="{DynamicResource C_293142}"
                        BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel>
                            <DataGrid x:Name="HistoryDataGrid"
                                        AutoGenerateColumns="False"
                                        IsReadOnly="True"
                                        CanUserAddRows="False"
                                        SelectionMode="Single"
                                        HeadersVisibility="Column"
                                        Background="{DynamicResource C_171C27}"
                                        Foreground="{DynamicResource C_F1F3F9}"
                                        BorderThickness="0"
                                        RowBackground="{DynamicResource C_171C27}"
                                        AlternatingRowBackground="{DynamicResource C_1B2230}"
                                        GridLinesVisibility="Horizontal"
                                        HorizontalGridLinesBrush="{DynamicResource C_293142}"
                                        MinHeight="280">

                                <DataGrid.Resources>
                                    <!-- History cell colours -->
                                    <Style TargetType="{x:Type DataGridCell}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground"
                    Value="{DynamicResource C_F1F3F9}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="6,8"/>
                                    </Style>

                                    <!-- Column heading colours -->
                                    <Style TargetType="{x:Type DataGridColumnHeader}">
                                        <Setter Property="Background"
                    Value="{DynamicResource C_222938}"/>
                                        <Setter Property="Foreground"
                    Value="{DynamicResource C_AAB3C5}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="8,10"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush"
                    Value="{DynamicResource C_293142}"/>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Title"
                            Binding="{Binding Title}"
                            Width="2*"/>
                                    <DataGridTextColumn Header="Date"
                            Binding="{Binding DateText}"
                            Width="150"/>
                                    <DataGridTextColumn Header="Format"
                            Binding="{Binding Format}"
                            Width="90"/>
                                    <DataGridTextColumn Header="Status"
                            Binding="{Binding Status}"
                            Width="95"/>
                                    <DataGridTextColumn Header="Details"
                            Binding="{Binding Message}"
                            Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="HistoryEmptyText" Text="No download attempts recorded yet."
                                   Foreground="{DynamicResource C_919BB0}" FontSize="12" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Open saved file" Style="{StaticResource PrimaryButton}"
                                    Click="OpenHistoryFileButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="SettingsPage" Margin="34,28,34,35" Visibility="Collapsed">
                <Grid Margin="0,0,0,28">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Personalise how Youtube Loader looks." Foreground="{DynamicResource C_919BB0}" FontSize="13" Margin="0,7,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource C_171C27}"
                        BorderBrush="{DynamicResource C_293142}"
                        BorderThickness="1" CornerRadius="14" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Choose the colour theme used throughout the application. Your choice is saved automatically."
                                   Foreground="{DynamicResource C_919BB0}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,18"/>
                        <TextBlock Text="Theme" FontSize="12" Foreground="{DynamicResource C_919BB0}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Light"/>
                        </ComboBox>
                        <TextBlock Text="Dark keeps the original look. Light uses a brighter background and darker text."
                                   Foreground="{DynamicResource C_919BB0}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
